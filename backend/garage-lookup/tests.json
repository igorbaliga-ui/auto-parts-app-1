{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Invalid phone rejected",
      "method": "GET",
      "path": "/?phone=123",
      "expectedStatus": 400
    },
    {
      "name": "Unknown promo code returns valid false",
      "method": "GET",
      "path": "/?check_promo=NOPE12",
      "expectedStatus": 200,
      "expectedBody": {"valid": false},
      "bodyMatcher": "exact"
    }
  ]
}