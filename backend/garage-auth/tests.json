{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Invalid phone rejected on GET",
      "method": "GET",
      "path": "/?phone=123",
      "expectedStatus": 400
    },
    {
      "name": "Invalid phone rejected on POST",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "phone": "123"},
      "expectedStatus": 400
    },
    {
      "name": "Invalid code rejected on verify_call",
      "method": "POST",
      "path": "/",
      "body": {"action": "verify_call", "phone": "9001234567", "code": "12"},
      "expectedStatus": 400
    }
  ]
}