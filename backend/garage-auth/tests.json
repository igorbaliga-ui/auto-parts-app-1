{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Invalid phone rejected on GET",
      "method": "GET",
      "path": "/?phone=123",
      "expectedStatus": 400
    },
    {
      "name": "Invalid phone rejected on POST",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "phone": "123"},
      "expectedStatus": 400
    },
    {
      "name": "Invalid code rejected on verify_call",
      "method": "POST",
      "path": "/",
      "body": {"action": "verify_call", "phone": "9001234567", "code": "12"},
      "expectedStatus": 400
    },
    {
      "name": "Invalid new_phone rejected on start_phone_change_call",
      "method": "POST",
      "path": "/",
      "body": {"action": "start_phone_change_call", "phone": "9001234567", "new_phone": "123"},
      "expectedStatus": 400
    },
    {
      "name": "Same new_phone rejected on start_phone_change_call",
      "method": "POST",
      "path": "/",
      "body": {"action": "start_phone_change_call", "phone": "9001234567", "new_phone": "9001234567"},
      "expectedStatus": 400
    },
    {
      "name": "admin_revert_phone_change requires admin password",
      "method": "POST",
      "path": "/",
      "body": {"action": "admin_revert_phone_change", "phone": "9001234567"},
      "expectedStatus": 401
    },
    {
      "name": "admin_reset_phone_change_limit requires admin password",
      "method": "POST",
      "path": "/",
      "body": {"action": "admin_reset_phone_change_limit", "phone": "9001234567"},
      "expectedStatus": 401
    }
  ]
}